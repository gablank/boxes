ARG BASE_IMAGE=ghcr.io/gablank/box-base:latest
FROM ${BASE_IMAGE}

ARG BUILD_DATE=unknown
ARG BUILD_SHA=unknown

# Priv-specific packages:
#   glab: GitLab CLI
#   fuse2: FUSE filesystem support
#   firefox: web browser
#   obsidian: markdown notes
#   openai-codex: OpenAI's terminal coding agent (Claude Code ships in base)
#   ipython: enhanced interactive Python shell (the `p3` alias)
RUN pacman -S --noconfirm --needed glab fuse2 firefox obsidian openai-codex \
    ipython && \
    pacman -Scc --noconfirm && \
    rm -rf /var/cache/pacman/pkg/*

COPY priv/local-bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/* 2>/dev/null || true

RUN printf 'build_date=%s\nbuild_sha=%s\nimage=box-priv\n' \
        "$BUILD_DATE" "$BUILD_SHA" > /etc/box-build-info

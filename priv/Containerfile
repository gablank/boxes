ARG BASE_IMAGE=ghcr.io/gablank/box-base:latest
FROM ${BASE_IMAGE}

ARG BUILD_DATE=unknown
ARG BUILD_SHA=unknown

# Priv-specific packages:
#   glab: GitLab CLI
#   fuse2: FUSE filesystem support
#   firefox: web browser
#   obsidian: markdown notes
#   openai-codex: OpenAI's terminal coding agent (Claude Code ships in base)
#   ipython: enhanced interactive Python shell (the `p3` alias)
#   blender: 3D suite, driven by agents through MCP for Blender (below)
#   nix: Nix package manager (configured below)
RUN pacman -Syu --noconfirm --needed glab fuse2 firefox obsidian openai-codex \
    ipython blender nix && \
    pacman -Scc --noconfirm && \
    rm -rf /var/cache/pacman/pkg/*

# Nix (official `extra/nix`), multi-user: nix-daemon runs as root and builds as
# the nixbld users the package's sysusers.d creates. The store, its database and
# every user profile live under /nix, which box.toml mounts from
# ~/distrobox/<box>/nix — without that mount every recreate empties the store
# and leaves ~/.nix-profile dangling. The socket starts the daemon on first use.
# nix-command + flakes are on so `nix run nixpkgs#...`/`nix develop` work as
# documented upstream. nix.conf is written here, at build time, so the setting
# is rebuilt every recreate rather than drifting in the writable layer.
# The package never creates /nix/store, and every nix command fails without it
# ("opening file /nix/store: No such file or directory"). It can't be made here
# either: the empty host mount hides the image's /nix. A tmpfiles.d entry makes
# it at boot, after the mount, before sockets.target starts the daemon socket.
# Keep in sync with work/Containerfile.
RUN printf '\nexperimental-features = nix-command flakes\n' >> /etc/nix/nix.conf && \
    printf 'd /nix/store 1775 root nixbld -\n' > /etc/tmpfiles.d/box-nix-store.conf && \
    systemctl enable nix-daemon.socket

# MCP for Blender (github.com/ahujasid/blender-mcp), pinned. One PyPI release
# ships both halves: the stdio MCP server that Claude Code/Codex launch, and the
# Blender add-on it talks to on localhost:9876. The add-on goes into the system
# `addons_core` dir: for the system scripts path Blender scans only that dir,
# never `addons` (see addon_utils.paths()). The user enables it once; the pref
# persists in $HOME. Don't also run `mcp-for-blender install-addon` — a second
# copy in ~/.config/blender would clash with this pinned one.
# /usr/local/bin/blender-mcp wraps the server to force its default-on telemetry
# off and to point its add-on check at that system dir. The uv cache is removed
# in the same RUN (layers are additive). Keep in sync with work/Containerfile.
ARG MCP_FOR_BLENDER_VERSION=2.0.3
RUN UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/opt/uv-tools/bin UV_PYTHON_DOWNLOADS=never \
        uv tool install --python /usr/bin/python3 "mcp-for-blender==${MCP_FOR_BLENDER_VERSION}" && \
    set -- /usr/share/blender/[0-9]*/ && [ "$#" -eq 1 ] && [ -d "$1" ] && \
    addons_dir="${1}scripts/addons_core" && [ -d "$addons_dir" ] && \
    cp /opt/uv-tools/mcp-for-blender/lib/python3*/site-packages/blender_mcp/bundled/addon.py \
        "$addons_dir/blender_mcp.py" && \
    printf '#!/bin/sh\nexport DISABLE_TELEMETRY=true\nexport BLENDERMCP_ADDONS_DIR=%s\nexec /opt/uv-tools/bin/mcp-for-blender "$@"\n' \
        "$addons_dir" > /usr/local/bin/blender-mcp && \
    chmod +x /usr/local/bin/blender-mcp && \
    rm -rf /root/.cache/uv

COPY priv/local-bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/* 2>/dev/null || true

RUN printf 'build_date=%s\nbuild_sha=%s\nimage=box-priv\n' \
        "$BUILD_DATE" "$BUILD_SHA" > /etc/box-build-info

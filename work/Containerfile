ARG BASE_IMAGE=ghcr.io/gablank/box-base:latest
FROM ${BASE_IMAGE}

ARG BUILD_DATE=unknown
ARG BUILD_SHA=unknown

# Work-specific packages:
#   kubectl, k9s: Kubernetes CLI + TUI dashboard
#   qemu-base, qemu-img: VM emulation and disk image tools
#   glab: GitLab CLI
#   podman + netavark + aardvark-dns + fuse-overlayfs + slirp4netns:
#     local rootless container runtime so docker/compose-spawned containers
#     live in workbox's netns (not the host's). Replaces the host podman.sock
#     bind that priv still uses.
#   firefox: web browser
#   obsidian: markdown notes
#   openai-codex: OpenAI's terminal coding agent (Claude Code ships in base)
#   ipython: enhanced interactive Python shell (the `p3` alias)
RUN pacman -Syu --noconfirm --needed kubectl k9s qemu-base qemu-img glab \
    podman netavark aardvark-dns fuse-overlayfs slirp4netns firefox obsidian \
    openai-codex ipython && \
    pacman -Scc --noconfirm && \
    rm -rf /var/cache/pacman/pkg/*

# Rootless podman inside distrobox: the user's systemd manager has no cgroup
# delegation, so the default systemd cgroup driver fails creating scope units
# with "interactive authentication required". Use cgroupfs and log events to
# a file (journald default also fails without a user journal).
RUN mkdir -p /etc/containers/containers.conf.d && \
    printf '[engine]\ncgroup_manager = "cgroupfs"\nevents_logger = "file"\n' \
        > /etc/containers/containers.conf.d/10-box-rootless.conf

# Stop inner podman containers cleanly when the box shuts down; otherwise
# systemd SIGKILLs the user slice, conmon never records the exits, and the
# containers reappear Dead/stuck after restart (see the unit file for detail).
# Enabled via symlink because systemctl --global needs a running systemd.
COPY work/systemd-user/podman-graceful-shutdown.service /etc/systemd/user/
RUN mkdir -p /etc/systemd/user/default.target.wants && \
    ln -s ../podman-graceful-shutdown.service \
        /etc/systemd/user/default.target.wants/podman-graceful-shutdown.service

COPY work/local-bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/* 2>/dev/null || true

RUN printf 'build_date=%s\nbuild_sha=%s\nimage=box-work\n' \
        "$BUILD_DATE" "$BUILD_SHA" > /etc/box-build-info

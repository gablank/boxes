FROM archlinux:latest

ARG BUILD_DATE=unknown
ARG BUILD_SHA=unknown

# archlinux:latest strips man pages from /usr/share/man/* and may carry
# NoExtract filters that block re-extraction. Drop any such filter up front
# so every package we install from here on ships its man pages.
RUN sed -i '/^NoExtract.*usr\/share\/\(man\|info\)/d' /etc/pacman.conf && \
    pacman-key --init && \
    pacman-key --populate archlinux && \
    pacman -Syu --noconfirm

# The packages baked into archlinux:latest were extracted while the bootstrap
# NoExtract filters were active, so their man/info pages are gone. Re-extract
# every preinstalled package NOW, before any customization below — a blanket
# reinstall later in the file would clobber file modifications made in earlier
# layers (it once silently overwrote the tailscale wrapper).
RUN pacman -Qqn | pacman -S --noconfirm --overwrite '*' -

# Pacman packages, grouped by purpose (one group per line below):
#   Build toolchain + core utils: base-devel glib2 git openssh sudo ...
#   Node.js runtime + npm: explicit dep for sandbox-runtime (see npm install below)
#   Shell & terminal: zsh tmux btop ghostty
#   Editors: nano vim (vi-vim-symlink from AUR aliases vi -> vim)
#   Python + polyglot runtime: python (also needed host-side for box.toml compiler), uv, mise (usage is a mise dep)
#   Rust toolchain manager: rustup (toolchains installed per-user via init-user.sh)
#   IaC: terraform
#   Container mgmt: docker docker-compose (talks to host podman socket)
#   Audio passthrough: pipewire libpipewire pipewire-alsa pipewire-pulse (client libs + ALSA/PA bridges for host PipeWire)
#   Git ecosystem: github-cli, git-absorb (auto-fixup), diff-so-fancy
#   Claude Code sandbox: bubblewrap (process isolation), socat (socket proxy),
#     libseccomp (BPF seccomp filters)
#   VPN: tailscale (client for per-box tailnets)
#   KDE integration: breeze-gtk (Breeze theme for GTK apps like Chrome), xdg-desktop-portal-kde (KDE notifications + file dialogs)
RUN pacman -S --noconfirm --needed \
    base-devel glib2 git openssh sudo ca-certificates curl wget gnupg inetutils \
    nodejs npm \
    man-db man-pages \
    zsh tmux btop less ghostty \
    jq tree ripgrep fd fzf unzip zip \
    nano vim \
    python uv mise usage \
    rustup \
    terraform \
    docker docker-compose \
    pipewire libpipewire pipewire-alsa pipewire-pulse \
    github-cli git-absorb diff-so-fancy \
    bubblewrap socat libseccomp \
    tailscale \
    breeze-gtk xdg-desktop-portal-kde

# Switch iptables/ip6tables to nftables backend (host kernel lacks ip_tables module)
RUN ln -sf /usr/bin/xtables-nft-multi /usr/bin/iptables && \
    ln -sf /usr/bin/xtables-nft-multi /usr/bin/iptables-restore && \
    ln -sf /usr/bin/xtables-nft-multi /usr/bin/iptables-save && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/iptables && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/iptables-restore && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/iptables-save && \
    ln -sf /usr/bin/xtables-nft-multi /usr/bin/ip6tables && \
    ln -sf /usr/bin/xtables-nft-multi /usr/bin/ip6tables-restore && \
    ln -sf /usr/bin/xtables-nft-multi /usr/bin/ip6tables-save && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/ip6tables && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/ip6tables-restore && \
    ln -sf /usr/bin/xtables-nft-multi /usr/sbin/ip6tables-save

# makepkg cannot run as root
RUN useradd -m -G wheel builduser && \
    printf 'builduser ALL=(ALL) NOPASSWD: ALL\n' > /etc/sudoers.d/builduser

# AUR packages are built from vetted PKGBUILDs vendored in aur/ — the build never
# fetches PKGBUILDs from the AUR (supply-chain control; see aur/README.md).
# makepkg still downloads each upstream artifact, but only from the official URL
# in the vetted PKGBUILD, gated by its committed checksums. Refresh/bump with
# `box vendor-aur <pkgbase>`.
COPY --chown=builduser:builduser aur/ /tmp/aur/

USER builduser

# yay first: it is built here so it still ships in the images for interactive
# `yay -S` after pulling. Only the image build is locked to vendored copies.
RUN cd /tmp/aur/yay && makepkg -si --noconfirm --needed

# Single-package pkgbases — build and install every package each produces:
#   IDEs / editors: visual-studio-code-bin, cursor-bin
#   Zsh framework: oh-my-zsh-git
#   Browser (exported via distrobox): google-chrome (desktop file patched later by chrome-wrapper)
#   Database CLI tools (mongodump, mongorestore, etc.): mongodb-tools
#   AI coding assistant (self-contained Bun binary): claude-code
RUN for b in visual-studio-code-bin cursor-bin oh-my-zsh-git google-chrome mongodb-tools claude-code; do \
      ( cd "/tmp/aur/$b" && makepkg -si --noconfirm --needed ) || exit 1; \
    done

# google-cloud-cli is a split pkgbase: build once, install only gcloud core + the
# GKE auth plugin for kubectl (not bq/gsutil/bundled-python).
RUN cd /tmp/aur/google-cloud-cli && \
    makepkg -s --noconfirm --needed && \
    sudo pacman -U --noconfirm \
      google-cloud-cli-[0-9]*.pkg.tar* \
      google-cloud-cli-component-gke-gcloud-auth-plugin-*.pkg.tar*

USER root
WORKDIR /
RUN rm -rf /tmp/aur

# vi -> vim symlink (vi-vim-symlink AUR package no longer exists)
RUN ln -sf /usr/bin/vim /usr/bin/vi

# Claude Code seccomp sandbox: provides BPF filters to block unix domain sockets
RUN npm install -g @anthropic-ai/sandbox-runtime

# Pre-install Cursor extensions to a system-wide directory.
# Uses /usr/bin/cursor directly (before wrapper is created).
RUN mkdir -p /opt/cursor-extensions && \
    for ext in \
        anysphere.cursorpyright \
        buenon.scratchpads \
        charliermarsh.ruff \
        eamodio.gitlens \
        hashicorp.terraform \
        k--kato.intellij-idea-keybindings \
        mads-hartmann.bash-ide-vscode \
        ms-python.debugpy \
        ms-python.python \
        redhat.vscode-yaml \
        rust-lang.rust-analyzer \
        tamasfe.even-better-toml \
        astral-sh.ty \
        DavidAnson.vscode-markdownlint \
        anthropic.claude-code \
        bierner.markdown-mermaid; \
    do \
        /usr/bin/cursor --no-sandbox --extensions-dir /opt/cursor-extensions \
            --install-extension "$ext" || true; \
    done

# Allow runtime users to write temp files inside extension directories (e.g. debugpy)
RUN chmod -R a+w /opt/cursor-extensions

# Wrapper so both CLI and .desktop launch use the pre-installed extensions
RUN printf '#!/bin/sh\nexec /usr/bin/cursor --extensions-dir /opt/cursor-extensions "$@"\n' \
        > /usr/local/bin/cursor && \
    chmod +x /usr/local/bin/cursor

RUN desktop_file=$(find /usr/share/applications -iname '*cursor*' 2>/dev/null | head -1) && \
    if [ -n "$desktop_file" ]; then \
        sed -i 's|\(Exec=.*cursor[^ ]*\)|\1 --extensions-dir /opt/cursor-extensions|' "$desktop_file"; \
    fi

RUN chmod u+s /usr/bin/newuidmap /usr/bin/newgidmap

# Container-local xdg-open so links open in the container browser
RUN printf '#!/bin/sh\nexec gio open "$@"\n' > /usr/local/bin/xdg-open && \
    chmod +x /usr/local/bin/xdg-open

# host-spawn: runs commands back on the host. distrobox bind-mounts only its own
# shell scripts (distrobox-export, distrobox-host-exec, distrobox-init) and no
# host-spawn binary — the host has none to mount, since it isn't a distrobox
# dependency on any distro. host-spawn has to live in the guest anyway: it runs
# inside the container and calls back out over the session D-Bus socket.
#
# distrobox instead downloads it at container init, best-effort and silent —
# distrobox-init runs `distrobox-host-exec -Y test 2>/dev/null >/dev/null || :`
# (ungated: init boxes run it too). Nothing retries if it fails, and what it
# writes goes to the container's writable layer, which every recreate
# (replace=true) discards. Empirically it lands in dev but not in priv/work;
# the untested suspect is egress at init time in their own netns
# (unshare_netns=true for the per-box tailnets).
#
# The cost of it being missing: /etc/profile.d/distrobox_profile.sh calls
# host-spawn on every login shell to import XAUTHORITY/XAUTHLOCALHOSTNAME/
# WAYLAND_DISPLAY/DISPLAY from the host, so each shell opens with
# "distrobox_profile.sh:20: command not found: host-spawn" and graphical apps
# launched from a login session lose the host display variables.
#
# Not in the official repos and not in the AUR, so this is a version-pinned
# download from the upstream release, checksum-gated: the same trust model as
# the vendored PKGBUILDs (official vendor URL + committed checksum). Images are
# x86_64 only, hence the hardcoded asset name — the sha256 pins that one file.
# Installed as /usr/bin/host-spawn, exactly where distrobox installs it, so a
# newer distrobox can overwrite it in place. The binary dispatches on its own
# argv[0]: renaming it (or symlinking another name to it) makes it run *that*
# command on the host instead, so it must keep the name host-spawn.
# Bump when distrobox raises host_spawn_version in distrobox-host-exec.
RUN host_spawn_version=v1.6.2 && \
    host_spawn_sha256=077bc09a087292447ba17cfe2156a93f71bf56c4c6be8e38d3abe65c1240f34c && \
    curl -sLfo /usr/bin/host-spawn \
        "https://github.com/1player/host-spawn/releases/download/${host_spawn_version}/host-spawn-x86_64" && \
    printf '%s  /usr/bin/host-spawn\n' "$host_spawn_sha256" | sha256sum -c - && \
    chmod +x /usr/bin/host-spawn

# Chrome wrapper: desktop-launched apps (distrobox-export) bypass shell init
# and PAM, so DBUS_SESSION_BUS_ADDRESS from /etc/environment is never set.
# This wrapper sources /etc/environment before exec'ing Chrome so screen
# sharing and notifications work via the host's xdg-desktop-portal.
# Depends on: google-chrome AUR package (installed above)
RUN printf '#!/bin/bash\nif [[ -f /etc/environment ]]; then\n    set -a; source /etc/environment; set +a\nfi\nexec /usr/bin/google-chrome-stable "$@"\n' \
        > /usr/local/bin/chrome-wrapper && \
    chmod +x /usr/local/bin/chrome-wrapper && \
    sed -i 's|/usr/bin/google-chrome-stable|/usr/local/bin/chrome-wrapper|g' \
        /usr/share/applications/google-chrome.desktop

RUN printf 'export ZSH=/usr/share/oh-my-zsh\nZSH_THEME="robbyrussell"\nplugins=(git)\nsource "$ZSH/oh-my-zsh.sh"\n' \
        > /etc/skel/.zshrc

# Tailscale: distrobox's entrypoint forwards every host /run socket into the
# container as a symlink (see /usr/bin/entrypoint, ~line 1939: it scans
# /run/host/run for sockets and links each one into the container's matching
# path). On hosts that run tailscaled, this would put the host's socket at
# /var/run/tailscale/tailscaled.sock and shadow the in-container daemon.
#
# Workaround: bind the in-container daemon to a different socket (box.sock),
# and replace /usr/bin/tailscale with a wrapper that always passes
# --socket=/var/run/tailscale/box.sock. This wins for absolute-path callers,
# cron, and anything else that bypasses PATH. The original binary moves to
# /usr/bin/tailscale.real. IgnorePkg keeps in-container `pacman -Syu` from
# overwriting the wrapper; image rebuilds reinstall fresh and re-apply.
RUN mkdir -p /etc/systemd/system/tailscaled.service.d && \
    printf '[Service]\nExecStart=\nExecStart=/usr/bin/tailscaled --state=/var/lib/tailscale/tailscaled.state --socket=/var/run/tailscale/box.sock --port 41641\n' \
        > /etc/systemd/system/tailscaled.service.d/socket-path.conf && \
    mv /usr/bin/tailscale /usr/bin/tailscale.real && \
    printf '#!/bin/sh\nexec /usr/bin/tailscale.real --socket=/var/run/tailscale/box.sock "$@"\n' \
        > /usr/bin/tailscale && \
    chmod +x /usr/bin/tailscale && \
    sed -i '/^\[options\]/a IgnorePkg = tailscale' /etc/pacman.conf && \
    systemctl enable tailscaled.service

# SSH host keys: stock sshd generates them into /etc/ssh on first start, which
# lives in the container's writable layer. Every recreate (`box upgrade`,
# `box assemble`, `box rescue` — all box.tomls set replace=true) therefore gave
# the box a brand-new SSH identity, while its tailscale node name and IP stayed
# put because /var/lib/tailscale is persisted. Same host, same address, new host
# key is exactly what ssh reports as a possible MITM, so every upgrade tripped
# "REMOTE HOST IDENTIFICATION HAS CHANGED" on every other box's known_hosts.
#
# Fix: keep the host keys in /var/lib/box-ssh, which boxes persist via a
# [[mount-dir]], and point HostKey at them. Setting any HostKey disables the
# /etc/ssh defaults, so the ephemeral keys sshdgenkeys.service still writes there
# are simply never offered. The generator runs as ExecStartPre because the
# mounted directory starts empty on a fresh host, and it re-applies mode 600
# every start — sshd refuses to load a host key that is group/world readable and
# exits with "no hostkeys available".
#
# Keys are generated at runtime, never baked into the image: this repo is
# public, and a host key shipped in the image would let anyone impersonate the
# box.
RUN printf '#!/bin/sh\nset -eu\nd=/var/lib/box-ssh\nmkdir -p "$d"\nfor t in ed25519 rsa ecdsa; do\n    k="$d/ssh_host_${t}_key"\n    [ -f "$k" ] || ssh-keygen -q -t "$t" -N "" -C "" -f "$k"\n    chmod 600 "$k"\n    chmod 644 "$k.pub" 2>/dev/null || true\ndone\n' \
        > /usr/local/sbin/box-sshd-keygen && \
    chmod +x /usr/local/sbin/box-sshd-keygen && \
    mkdir -p /var/lib/box-ssh /etc/systemd/system/sshd.service.d && \
    printf 'HostKey /var/lib/box-ssh/ssh_host_ed25519_key\nHostKey /var/lib/box-ssh/ssh_host_rsa_key\nHostKey /var/lib/box-ssh/ssh_host_ecdsa_key\n' \
        > /etc/ssh/sshd_config.d/10-box-host-keys.conf && \
    printf '[Service]\nExecStartPre=/usr/local/sbin/box-sshd-keygen\n' \
        > /etc/systemd/system/sshd.service.d/persistent-host-keys.conf && \
    systemctl enable sshd.service

# Mask the user-session D-Bus so the container's systemd --user never starts its
# own bus. All apps (terminal and desktop-launched) use the host bus instead,
# which is required for xdg-desktop-portal (screen sharing) and keyring access.
RUN systemctl --global mask dbus-daemon.service dbus-broker.service

COPY scripts/init-root.sh /usr/local/share/box-init/init-root.sh
COPY scripts/init-user.sh /usr/local/share/box-init/init-user.sh
COPY scripts/shell-init.sh /usr/local/share/box-init/shell-init.sh
COPY scripts/shell-env.sh /usr/local/share/box-init/shell-env.sh
RUN chmod +x /usr/local/share/box-init/init-root.sh /usr/local/share/box-init/init-user.sh /usr/local/share/box-init/shell-init.sh /usr/local/share/box-init/shell-env.sh

# shell-env.sh holds env that non-interactive shells need too, so it is hooked
# in system-wide rather than from a dotfile: ~/.zshrc is interactive-only, and a
# per-home dotfile would have to be re-appended to every box's home. Arch builds
# zsh with etcdir=/etc/zsh, and /etc/zsh/zshenv is read by every zsh — login or
# not, interactive or not — before ~/.zshenv. /etc/profile.d covers bash and sh
# login shells. Both are `.`-sourced with a readability guard so a shell never
# dies on a missing file.
RUN mkdir -p /etc/zsh && \
    printf '[ -r /usr/local/share/box-init/shell-env.sh ] && . /usr/local/share/box-init/shell-env.sh\n' \
        > /etc/zsh/zshenv && \
    printf '[ -r /usr/local/share/box-init/shell-env.sh ] && . /usr/local/share/box-init/shell-env.sh\n' \
        > /etc/profile.d/box-env.sh

COPY local-bin/ /usr/local/bin/
RUN chmod +x /usr/local/bin/* 2>/dev/null || true

RUN printf 'build_date=%s\nbuild_sha=%s\nimage=box-base\n' \
        "$BUILD_DATE" "$BUILD_SHA" > /etc/box-build-info

RUN mandb --quiet && \
    rm -rf /tmp/* && \
    rm -f /etc/sudoers.d/builduser && \
    userdel -r builduser 2>/dev/null || true && \
    pacman -Scc --noconfirm && \
    rm -rf /var/cache/pacman/pkg/*
